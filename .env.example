# Required: pooled PostgreSQL connection used by the application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Required: direct PostgreSQL connection used by Prisma migrations.
# Prisma Postgres' Vercel integration provides this variable automatically.
POSTGRES_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public URL of this deployment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Protects the scheduled crawler endpoint in production.
CRON_SECRET="replace-with-a-random-secret"

# Crawling is paused by default. Set to "true" only when scheduled collection
# is intentionally enabled again.
CRAWLER_ENABLED="false"

# Optional integrations. Leave empty to use the built-in fallbacks.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"
RESEND_API_KEY=""
EMAIL_FROM="FundRadar <onboarding@resend.dev>"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
CRAWLER_USER_AGENT="FundRadarBot/1.0 (+https://fundradar.example/bot)"
