{
  "name": "fundradar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "smoke": "node tests/phase1.smoke.mjs && node tests/phase2.smoke.mjs && node tests/phase3.smoke.mjs && node tests/phase6.smoke.mjs && node tests/admin-ux.smoke.mjs",
    "check:search": "tsx --tsconfig tsconfig.scripts.json tests/search.check.ts",
    "db:fixtures": "tsx prisma/dev-fixtures.ts",
    "smoke:public": "node tests/phase2.smoke.mjs",
    "smoke:leads": "node tests/phase3.smoke.mjs",
    "check:ingestion": "tsx --tsconfig tsconfig.scripts.json tests/ingestion.check.ts",
    "check:crawler": "tsx --tsconfig tsconfig.scripts.json tests/crawler.check.ts",
    "test:cleanup": "tsx --tsconfig tsconfig.scripts.json tests/cleanup.ts",
    "check:seed": "tsx --tsconfig tsconfig.scripts.json tests/seed.check.ts",
    "smoke:ingest": "node tests/phase4.smoke.mjs; npm run test:cleanup",
    "check": "npm run check:search && npm run check:ingestion && npm run check:crawler && npm run check:seed",
    "smoke:admin": "node tests/admin-ux.smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.35.0",
    "next": "15.5.24",
    "prisma": "^6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.24.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.24",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
